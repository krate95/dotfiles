# swaylock - Catppuccin Mocha palette, aligned with hyprlock where supported.
# Upstream swaylock does not support arbitrary labels, rectangular input fields,
# blur, or fingerprint prompt text like hyprlock.

daemonize
ignore-empty-password
show-failed-attempts
font=CaskaydiaCove Nerd Font
font-size=25

color=1e2030

inside-color=1e203000
inside-clear-color=1e203000
inside-caps-lock-color=1e203000
inside-ver-color=1e203000
inside-wrong-color=1e203000

ring-color=c8c8c8
ring-clear-color=c8c8c8
ring-caps-lock-color=eed49f
ring-ver-color=c8c8c8
ring-wrong-color=eb6f92

line-color=c8c8c8
line-clear-color=c8c8c8
line-caps-lock-color=eed49f
line-ver-color=c8c8c8
line-wrong-color=eb6f92

key-hl-color=c8c8c8
bs-hl-color=eb6f92

separator-color=00000000

text-color=c8c8c8
text-clear-color=c8c8c8
text-caps-lock-color=eed49f
text-ver-color=c8c8c8
text-wrong-color=eb6f92

indicator-idle-visible
indicator-radius=50
indicator-thickness=3
indicator-caps-lock
