# kanshi — perfiles de outputs dinámicos
# Documentación: https://sr.ht/~emersion/kanshi/
#
# Para identificar el nombre de un output conectado:
#   swaymsg -t get_outputs | grep -E '"name"|"make"|"model"'

# Solo portátil
profile laptop {
    output eDP-1 mode 1920x1080 scale 1.25 position 0,0
}

# Portátil + ultrawide
profile docked {
    output DP-6  mode 3440x1440 position 0,0
    output eDP-1 mode 1920x1080 scale 1.25 position 3440,0
}

# Portátil + monitor portátil 1080p
# TODO: sustituir "PLACEHOLDER" por el nombre real del output
#       (conectar el monitor y ejecutar: swaymsg -t get_outputs | grep '"name"')
profile portable {
    output PLACEHOLDER mode 1920x1080 position 0,0
    output eDP-1      mode 1920x1080 scale 1.25 position 1920,0
}
