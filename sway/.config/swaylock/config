# swaylock — estilo equivalente a hyprlock.conf
# Nota: swaylock vanilla no soporta blur. Si quieres blur, usa swaylock-effects
# y descomenta effect-blur/effect-vignette más abajo.

daemonize
ignore-empty-password
show-failed-attempts

# Fondo sólido (equivalente a background.color = rgb(1e2030))
color=1e2030

# Tipografía
font=CaskaydiaCove Nerd Font
font-size=25

# Indicador
indicator
indicator-radius=100
indicator-thickness=7
indicator-caps-lock

# Colores (paleta Catppuccin-ish: lavender + gris claro)
ring-color=b7bdf8
ring-clear-color=b7bdf8
ring-ver-color=b7bdf8
ring-wrong-color=eb6f92
key-hl-color=b7bdf8
bs-hl-color=eb6f92
inside-color=c8c8c8
inside-clear-color=c8c8c8
inside-ver-color=c8c8c8
inside-wrong-color=c8c8c8
text-color=0a0a0a
text-clear-color=0a0a0a
text-ver-color=0a0a0a
text-wrong-color=0a0a0a
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000

fade-in=0.2

# Solo swaylock-effects:
#effect-blur=8x3
#effect-vignette=0.5:0.5
