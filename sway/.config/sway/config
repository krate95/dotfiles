### ######################################################################
### Sway config for Kubuntu — functional replica of the Hyprland config.
### Uses KDE lock (kscreenlocker) and lives alongside Plasma as an
### alternative session selectable from SDDM.
### Notes: Sway does not natively support rounding, blur, or animations.
### ######################################################################

################
### VARIABLES ###
################
set $mod Mod4
set $term kitty
set $fileManager thunar
set $menu wofi --show drun

###############
### OUTPUTS ###
###############
# Outputs are managed dynamically by kanshi (see ~/.config/kanshi/config)

#############
### INPUT ###
#############
input "type:keyboard" {
    xkb_layout us
    xkb_variant altgr-intl
}

input "type:touchpad" {
    natural_scroll enabled
    tap enabled
    dwt enabled
}

focus_follows_mouse yes

# Cursor
seat seat0 xcursor_theme default 24

#################
### AUTOSTART ###
#################
exec kwalletd5
exec_always --no-startup-id sh -c 'pkill -x kanshi || true; exec kanshi'
exec_always --no-startup-id sh -c 'pkill -x waybar || true; exec waybar -c ~/.config/waybar/config-sway -s ~/.config/waybar/style-sway.css'
exec dunst
exec swayosd-server
exec ~/.config/sway/scripts/sway-idle.sh
# NetworkManager secret agent (without this: "failed to get secrets, no agents")
exec nm-applet --indicator
# Only when the Sway session starts; do not relaunch on reload or resume from sleep/hibernate.
exec swaymsg 'workspace number 1; exec $term'

###############
### APPEARANCE
###############
# Gaps equivalent to general { gaps_in = 5; gaps_out = 5 }
gaps inner 3
gaps outer 3

# 2px border, without titlebars (like Hyprland)
default_border pixel 2
default_floating_border pixel 2
titlebar_padding 1
font pango:CaskaydiaCove Nerd Font 10

# Equivalent colors:
#   active_border   = #b7bdf8
#   inactive_border = #595959
#                       border    bground   text      indicator child_border
client.focused          #b7bdf8   #b7bdf8   #1e2030   #b7bdf8   #b7bdf8
client.focused_inactive #595959   #595959   #ffffff   #595959   #595959
client.unfocused        #595959   #595959   #ffffff   #595959   #595959
client.urgent           #eb6f92   #eb6f92   #1e2030   #eb6f92   #eb6f92

####################
### KEYBINDINGS  ###
####################

# Drag/resize floating windows with the modifier
floating_modifier $mod normal

bindsym $mod+Return exec $term
bindsym $mod+slash exec ~/.config/sway/scripts/cheatsheet.sh
bindsym $mod+q kill
bindsym $mod+m exec swaymsg exit
bindsym $mod+Ctrl+Shift+r reload
bindsym $mod+e exec $fileManager
bindsym $mod+v floating toggle
bindsym $mod+space exec $menu
bindsym $mod+j split toggle
# Lock: loginctl triggers the swayidle 'lock' handler (kscreenlocker_greet).
bindsym $mod+l exec loginctl lock-session

# Focus with arrow keys
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

# Move windows with arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Scratchpad (equivalent to the "magic" special workspace)
bindsym $mod+s scratchpad show
bindsym $mod+Shift+s move scratchpad

# Scroll to switch workspace
bindsym $mod+button4 workspace prev_on_output
bindsym $mod+button5 workspace next_on_output

# Toggle idle
bindsym $mod+Shift+i exec ~/.config/sway/scripts/toggle-idle.sh

# Screenshots
bindsym Print exec ~/.config/sway/scripts/screenshot.sh area
bindsym Shift+Print exec ~/.config/sway/scripts/screenshot.sh screen

# Volume and brightness (--locked = also responds when the screen is locked)
bindsym --locked XF86AudioRaiseVolume exec ~/.config/waybar/scripts/volume.sh up
bindsym --locked XF86AudioLowerVolume exec ~/.config/waybar/scripts/volume.sh down
bindsym --locked XF86AudioMute exec ~/.config/waybar/scripts/volume.sh mute
bindsym --locked XF86AudioMicMute exec ~/.config/waybar/scripts/volume.sh mute-mic
bindsym --locked XF86MonBrightnessUp exec ~/.config/waybar/scripts/brightness.sh up
bindsym --locked XF86MonBrightnessDown exec ~/.config/waybar/scripts/brightness.sh down

# Playerctl with swayosd
bindsym --locked XF86AudioNext exec swayosd-client --playerctl next
bindsym --locked XF86AudioPause exec swayosd-client --playerctl play-pause
bindsym --locked XF86AudioPlay exec swayosd-client --playerctl play-pause
bindsym --locked XF86AudioPrev exec swayosd-client --playerctl prev

# CapsLock OSD
bindsym --release Caps_Lock exec swayosd-client --caps-lock-led input3::capslock

#############
### GESTURES
#############
# gesture = 3, horizontal, workspace
bindgesture swipe:3:right workspace prev_on_output
bindgesture swipe:3:left  workspace next_on_output

################
### WINDOW RULES
################
# Hyprland-run equivalent: floating window anchored to the bottom-left
for_window [app_id="hyprland-run"] floating enable, resize set 600 80, move position 20 px 100 px from bottom

for_window [class="Bitwarden"] floating enable
for_window [class="FortiClient"] floating enable

# Include optional local overrides
include /etc/sway/config.d/*
