;; Kanata config — ThinkPad T490s
;;
;; Caps Lock (tap)  → Caps Lock normal
;; Caps Lock (hold) → capa de navegación: WASD = flechas
;;
;; Para salir de kanata: LCtrl + Space + Esc (teclas físicas)

(defcfg
  ;; kanata detecta el teclado automáticamente.
  ;; Para limitarlo solo al teclado interno del T490s, descomenta:
  ;; linux-dev /dev/input/by-path/platform-i8042-serio-0-event-kbd

  ;; Pasa teclas no definidas en defsrc (Fn, teclas multimedia, etc.)
  process-unmapped-keys yes
)

;; Teclas físicas que kanata va a interceptar
(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rctl
)

(defalias
  ;; tap=nada, hold=capa nav
  cap (tap-hold 200 200 XX (layer-while-held nav))
)

;; Capa base: QWERTY normal, Caps Lock sustituido por el alias
(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rctl
)

;; Capa nav: activa mientras se mantiene Caps Lock
;; _ = comportamiento heredado de la capa base
(deflayer nav
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  _
  _    _    up   _    _    _    _    _    _    _    _    _    _    _
  _    lft  down rght _    _    _    _    _    _    _    _    _
  _    mute vold   volu  _    _    _    _    _    _    _    _
  _    _    _              _              _    _
)
